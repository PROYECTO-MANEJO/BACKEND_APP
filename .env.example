# ==============================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================
NODE_ENV=development
PORT=3000

# ==============================================
# BASE DE DATOS
# ==============================================
# Para desarrollo local con Docker
DATABASE_URL="postgresql://postgres:password@localhost:5432/backend_db"

# Configuración individual de la BD
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend_db
DB_USER=postgres
DB_PASSWORD=password

# Redis
REDIS_URL="redis://:redis123@localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ==============================================
# AUTENTICACIÓN JWT
# ==============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================
# CONFIGURACIÓN DE EMAIL
# ==============================================
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourapp.com

# ==============================================
# CONFIGURACIÓN DE SEGURIDAD
# ==============================================
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================
# SERVICIOS EXTERNOS
# ==============================================
# GitHub Integration (Phase 8)
GITHUB_TOKEN=your-github-token
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=your-repository

# PDF Generation Service
PDF_SERVICE_URL=http://localhost:3001
PDF_SERVICE_API_KEY=your-pdf-service-key

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:3002
NOTIFICATION_API_KEY=your-notification-key

# ==============================================
# LOGGING Y MONITOREO
# ==============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
ENABLE_REQUEST_LOGGING=true

# ==============================================
# CONFIGURACIÓN DE DESARROLLO
# ==============================================
ENABLE_SWAGGER=true
ENABLE_DEBUG_ROUTES=true
MOCK_EXTERNAL_SERVICES=true