# Base de datos PostgreSQL (Docker)
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=appeventos_db
DB_HOST=localhost
DB_PORT=5432

# URL de conexión completa para el backend (apunta al contenedor Docker en localhost)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/appeventos_db

# Servidor
PORT=3000

# JWT Secret (CAMBIAR EN PRODUCCIÓN)
SECRET_KEY=tu_clave_secreta_super_segura_cambiar_en_produccion

# CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Email (SMTP) - Configurar con tus credenciales reales
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_password_de_aplicacion
EMAIL_FROM=tu_email@gmail.com
