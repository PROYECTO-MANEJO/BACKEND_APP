{
  "watch": [
    "controllers",
    "routes",
    "services",
    "middlewares",
    "helpers",
    "index.js",
    "prisma/schema.prisma"
  ],
  "ignore": [
    "node_modules",
    "*.log",
    "*.md",
    "package-lock.json",
    "prisma/migrations",
    "scripts"
  ],
  "ext": "js,json",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": "1000"
} 