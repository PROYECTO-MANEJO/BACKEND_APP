{
  "name": "backend_app",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:legacy": "node index.js",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "dev:legacy": "nodemon index.js",
    "dev:watch": "nodemon --exec ts-node -r tsconfig-paths/register src/main.ts",
    "dev:server": "ts-node -r tsconfig-paths/register src/Server.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build:prod": "npm run build && npm run prisma:generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "check-github": "node scripts/verify-github-config.js",
    "setup:env": "cp .env.example .env",
    "setup": "npm install && npm run setup:env && npm run prisma:generate",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:restart": "bash scripts/db.sh restart",
    "db:logs": "bash scripts/db.sh logs",
    "db:status": "bash scripts/db.sh status",
    "db:connect": "bash scripts/db.sh connect",
    "db:backup": "bash scripts/db.sh backup",
    "db:clean": "bash scripts/db.sh clean",
    "db:help": "bash scripts/db.sh help",
    "postgres": "bash scripts/postgres-only.sh",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@octokit/rest": "^18.12.0",
    "@prisma/client": "^6.10.1",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "fs": "^0.0.1-security",
    "get-stream": "^6.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.3",
    "path": "^0.12.7",
    "pdfkit": "^0.17.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "nodemon": "^3.1.10",
    "prisma": "^6.10.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
